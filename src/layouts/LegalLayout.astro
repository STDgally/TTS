---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description} noindex>
  <PageHero eyebrow="Informazioni legali">{title}</PageHero>
  <section class="section theme-light" data-section-label={title}>
    <div class="container">
      <div class="legal-draft" role="note">
        <strong>Documento da completare.</strong>
        Questa pagina è una bozza strutturale: i testi tra parentesi quadre vanno sostituiti con le informazioni reali
        del titolare, preferibilmente con il supporto di un consulente legale. Non pubblicare il sito in produzione
        senza averla completata.
      </div>
      <div class="legal-prose">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-draft {
    max-width: 72ch;
    padding: 1.25rem 1.5rem;
    margin-bottom: 3rem;
    background: #fff7d6;
    color: #4a3b00;
    border-left: 4px solid #d1a300;
    border-radius: var(--radius);
    line-height: 1.55;
  }
  .legal-prose {
    max-width: 72ch;
    line-height: 1.7;
  }
  .legal-prose :global(h2) {
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 2.75rem 0 1rem;
  }
  .legal-prose :global(p + p),
  .legal-prose :global(ul) {
    margin-top: 1rem;
  }
  .legal-prose :global(ul) {
    padding-left: 1.25rem;
  }
  .legal-prose :global(li + li) {
    margin-top: 0.4rem;
  }
  .legal-prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .legal-prose :global(.placeholder) {
    background: rgb(184 255 59 / 0.45);
    padding-inline: 0.2em;
  }
</style>
