---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand, colors, fonts, seo, logo } from '../config/site';

interface Props {
  /** Titolo della pagina (senza suffisso). Ometti per usare il titolo di default. */
  title?: string;
  description?: string;
  /** true per escludere la pagina dall'indicizzazione (es. bozze legali). */
  noindex?: boolean;
  ogImage?: string;
}

const { title, description = seo.defaultDescription, noindex = false, ogImage = seo.ogImage } = Astro.props;

const fullTitle = title ? seo.titleTemplate.replace('%s', title) : seo.defaultTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const rootVars = `:root{${Object.entries(colors)
  .map(([k, v]) => `--color-${k}:${v};`)
  .join('')}--font-display:${fonts.display};--font-body:${fonts.body};}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brand.name,
  alternateName: `${brand.mark} — ${brand.meaning}`,
  url: new URL('/', Astro.site).href,
  logo: new URL(logo.full.fallback, Astro.site).href,
  description: seo.defaultDescription,
  founder: brand.founders.map((name) => ({ '@type': 'Person', name })),
  areaServed: 'IT',
};
---

<!doctype html>
<html lang={brand.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content={colors.black} />
    <meta name="color-scheme" content="dark light" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={brand.locale} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo TTS. Web Agency su fondo nero" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <style is:inline set:html={rootVars}></style>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <Header />
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
