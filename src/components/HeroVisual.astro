---
// Composizione grafica originale: finestre browser, griglia e annotazioni
// da interfaccia digitale. Puramente decorativa.
---

<div class="hv" aria-hidden="true">
  <div class="hv-dot"></div>

  <!-- Finestra browser principale -->
  <div class="hv-browser">
    <div class="hv-bar">
      <span class="hv-lights"><i></i><i></i><i></i></span>
      <span class="hv-url">la-tua-attivita.it</span>
      <span class="hv-bar-end">↻</span>
    </div>
    <div class="hv-page">
      <div class="hv-nav">
        <b class="hv-logo"></b>
        <span class="hv-navlinks"><i></i><i></i><i></i></span>
        <b class="hv-navbtn"></b>
      </div>
      <div class="hv-head">
        <b class="hv-line hv-line--xl" style="--d:1"></b>
        <b class="hv-line hv-line--xl hv-line--acid" style="--d:2"><span class="hv-caret"></span></b>
        <b class="hv-line hv-line--sm" style="--d:3"></b>
        <b class="hv-btn" style="--d:4"></b>
      </div>
      <div class="hv-cards">
        <b style="--d:5"><i></i></b>
        <b style="--d:6"><i></i></b>
        <b style="--d:7"><i></i></b>
      </div>
    </div>
    <span class="hv-cross hv-cross--tl"></span>
    <span class="hv-cross hv-cross--br"></span>
  </div>

  <!-- Smartphone -->
  <div class="hv-phone">
    <div class="hv-phone-notch"></div>
    <b class="hv-line hv-line--xl" style="--d:3"></b>
    <b class="hv-line hv-line--xl hv-line--acid" style="--d:4"></b>
    <b class="hv-line hv-line--sm" style="--d:5"></b>
    <b class="hv-pbtn" style="--d:6"></b>
    <b class="hv-pcard" style="--d:7"></b>
  </div>

  <!-- Annotazioni -->
  <div class="hv-measure"><span>1440</span></div>
  <div class="hv-chip"><i></i>Time to shine</div>
  <div class="hv-coords">x 128 · y 64</div>
</div>

<style>
  .hv {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 0.86;
    --c-line: rgb(255 255 255 / 0.14);
    --c-fill: rgb(255 255 255 / 0.09);
  }
  .hv-dot {
    position: absolute;
    width: 42%;
    aspect-ratio: 1;
    right: -4%;
    top: -6%;
    border-radius: 50%;
    background: var(--color-acid);
    opacity: 0.95;
  }

  .hv-browser {
    position: absolute;
    left: 0;
    top: 10%;
    width: 84%;
    aspect-ratio: 16 / 11;
    background: #161616;
    border: 1px solid var(--c-line);
    border-radius: 10px;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.8);
  }
  .hv-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 2.25rem;
    padding-inline: 0.85rem;
    border-bottom: 1px solid var(--c-line);
    font-size: 0.6875rem;
    color: rgb(255 255 255 / 0.5);
  }
  .hv-lights {
    display: flex;
    gap: 5px;
  }
  .hv-lights i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.35);
  }
  .hv-lights i:first-child {
    background: var(--color-acid);
    border-color: var(--color-acid);
  }
  .hv-url {
    flex: 1;
    max-width: 60%;
    margin-inline: auto;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    text-align: center;
    font-family: var(--font-display);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hv-page {
    padding: 6% 7%;
    display: grid;
    gap: 9%;
    height: calc(100% - 2.25rem);
    grid-template-rows: auto 1fr auto;
  }
  .hv-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .hv-logo {
    width: 2.25rem;
    height: 0.6rem;
    background: var(--color-acid);
    border-radius: 2px;
  }
  .hv-navlinks {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }
  .hv-navlinks i {
    width: 1.6rem;
    height: 0.3rem;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.22);
  }
  .hv-navbtn {
    width: 2.6rem;
    height: 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-acid);
  }
  .hv-head {
    display: grid;
    gap: 0.55rem;
    align-content: center;
  }
  .hv-line {
    display: block;
    height: 0.85rem;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.85);
    transform-origin: left;
    position: relative;
  }
  .hv-line--xl {
    width: 78%;
    height: clamp(0.8rem, 2vw, 1.3rem);
  }
  .hv-line--xl + .hv-line--xl {
    width: 56%;
  }
  .hv-line--acid {
    background: var(--color-acid);
  }
  .hv-line--sm {
    width: 44%;
    height: 0.35rem;
    margin-top: 0.4rem;
    background: rgb(255 255 255 / 0.3);
  }
  .hv-caret {
    position: absolute;
    right: -0.5rem;
    top: -15%;
    width: 2px;
    height: 130%;
    background: var(--color-white);
  }
  .hv-btn {
    width: 5.5rem;
    height: 1.4rem;
    margin-top: 0.5rem;
    border-radius: 999px;
    background: var(--color-acid);
    transform-origin: left;
  }
  .hv-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
  }
  .hv-cards b {
    display: block;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--c-line);
    border-radius: 4px;
    background: var(--c-fill);
    position: relative;
  }
  .hv-cards b i {
    position: absolute;
    left: 12%;
    bottom: 16%;
    width: 46%;
    height: 0.3rem;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.35);
  }
  .hv-cards b:nth-child(2) {
    background: rgb(184 255 59 / 0.12);
    border-color: rgb(184 255 59 / 0.4);
  }

  .hv-cross {
    position: absolute;
    width: 14px;
    height: 14px;
  }
  .hv-cross::before,
  .hv-cross::after {
    content: '';
    position: absolute;
    background: var(--color-acid);
  }
  .hv-cross::before {
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
  }
  .hv-cross::after {
    top: 50%;
    left: 0;
    height: 1px;
    width: 100%;
  }
  .hv-cross--tl {
    left: -7px;
    top: -7px;
  }
  .hv-cross--br {
    right: -7px;
    bottom: -7px;
  }

  .hv-phone {
    position: absolute;
    right: 2%;
    bottom: 0;
    width: 27%;
    aspect-ratio: 9 / 18.5;
    padding: 14% 8% 8%;
    display: grid;
    align-content: start;
    gap: 0.45rem;
    background: var(--color-black);
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: 16px;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.9);
  }
  .hv-phone-notch {
    position: absolute;
    top: 5%;
    left: 50%;
    width: 32%;
    height: 4px;
    border-radius: 4px;
    transform: translateX(-50%);
    background: rgb(255 255 255 / 0.25);
  }
  .hv-phone .hv-line--xl {
    width: 92%;
    height: 0.6rem;
  }
  .hv-phone .hv-line--xl + .hv-line--xl {
    width: 70%;
  }
  .hv-phone .hv-line--sm {
    width: 80%;
    height: 0.25rem;
  }
  .hv-pbtn {
    width: 60%;
    height: 0.8rem;
    margin-top: 0.3rem;
    border-radius: 999px;
    background: var(--color-acid);
    transform-origin: left;
  }
  .hv-pcard {
    margin-top: 0.4rem;
    aspect-ratio: 4 / 3;
    border-radius: 4px;
    border: 1px solid var(--c-line);
    background: var(--c-fill);
  }

  .hv-measure {
    position: absolute;
    left: 0;
    width: 84%;
    top: 4%;
    height: 10px;
    border-inline: 1px solid rgb(255 255 255 / 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hv-measure::before {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: rgb(255 255 255 / 0.2);
  }
  .hv-measure span {
    position: relative;
    padding-inline: 0.5rem;
    background: var(--color-black);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: rgb(255 255 255 / 0.55);
    font-family: var(--font-display);
  }
  .hv-chip {
    position: absolute;
    left: -2%;
    bottom: 8%;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-black);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8125rem;
    box-shadow: 0 20px 40px -16px rgb(0 0 0 / 0.7);
  }
  .hv-chip i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-acid);
    box-shadow: 0 0 0 3px rgb(184 255 59 / 0.35);
  }
  .hv-coords {
    position: absolute;
    right: 31%;
    bottom: 2%;
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: rgb(255 255 255 / 0.4);
    text-transform: uppercase;
  }

  @media (max-width: 520px) {
    .hv-chip {
      font-size: 0.6875rem;
      padding: 0.4rem 0.7rem;
    }
    .hv-coords {
      display: none;
    }
    .hv-cards b i,
    .hv-navlinks {
      display: none;
    }
  }

  /* Animazioni discrete, solo se il movimento è consentito */
  @media (prefers-reduced-motion: no-preference) {
    .hv-browser,
    .hv-phone,
    .hv-chip,
    .hv-dot {
      animation: hv-in 1.2s var(--ease-out) both;
    }
    .hv-browser {
      animation-delay: 0.15s;
    }
    .hv-phone {
      animation:
        hv-in 1.2s var(--ease-out) 0.45s both,
        hv-float 7s var(--ease-in-out) 1.8s infinite alternate;
    }
    .hv-chip {
      animation:
        hv-in 1s var(--ease-out) 0.9s both,
        hv-float 6s var(--ease-in-out) 2s infinite alternate-reverse;
    }
    .hv-dot {
      animation: hv-scale 1.4s var(--ease-out) both;
    }
    .hv-line,
    .hv-btn,
    .hv-pbtn {
      animation: hv-build 0.9s var(--ease-out) both;
      animation-delay: calc(0.5s + var(--d, 0) * 0.12s);
    }
    .hv-cards b,
    .hv-pcard {
      animation: hv-in 0.9s var(--ease-out) both;
      animation-delay: calc(0.5s + var(--d, 0) * 0.12s);
    }
    .hv-caret {
      animation: hv-blink 1.1s steps(1) 1.6s infinite;
    }
  }
  @keyframes hv-in {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
  }
  @keyframes hv-scale {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }
  @keyframes hv-build {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes hv-float {
    to {
      transform: translateY(-12px);
    }
  }
  @keyframes hv-blink {
    50% {
      opacity: 0;
    }
  }
</style>
