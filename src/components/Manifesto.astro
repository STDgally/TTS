---
const pillars = [
  {
    title: 'Design con personalità',
    text: 'Scelte visive che partono da chi sei, non da un modello già visto.',
    glyph: 'dot',
  },
  {
    title: 'Comunicazione diretta',
    text: 'Messaggi chiari, che arrivano subito a chi visita il sito.',
    glyph: 'arrow',
  },
  {
    title: 'Attenzione ai dettagli',
    text: 'Spaziature, allineamenti, stati: le piccole cose che fanno la differenza.',
    glyph: 'grid',
  },
];
---

<section class="section theme-acid manifesto" aria-labelledby="manifesto-title">
  <div class="container">
    <h2 id="manifesto-title" class="manifesto-title" data-reveal>
      Non facciamo siti <span class="manifesto-strike">tutti uguali</span>.
    </h2>
    <div class="grid-12 manifesto-body">
      <p class="manifesto-lead" data-reveal>
        Ogni attività ha una propria identità. Il nostro compito è trasformarla in un’esperienza digitale chiara,
        coerente e riconoscibile.
      </p>
    </div>
    <ul role="list" class="pillars">
      {
        pillars.map((p, i) => (
          <li class="pillar" data-reveal style={`--reveal-delay:${i * 120}`}>
            <span class="pillar-glyph" aria-hidden="true">
              {p.glyph === 'dot' && (
                <svg viewBox="0 0 48 48" fill="none">
                  <circle cx="24" cy="24" r="23" stroke="currentColor" />
                  <circle cx="33" cy="33" r="9" fill="currentColor" />
                </svg>
              )}
              {p.glyph === 'arrow' && (
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M10 38 38 10M16 10h22v22" />
                </svg>
              )}
              {p.glyph === 'grid' && (
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor">
                  <path d="M1 16h46M1 32h46M16 1v46M32 1v46" />
                  <rect x="16" y="16" width="16" height="16" fill="currentColor" />
                </svg>
              )}
            </span>
            <span class="pillar-num">0{i + 1}</span>
            <h3 class="h3">{p.title}</h3>
            <p class="pillar-text">{p.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .manifesto {
    overflow: hidden;
  }
  .manifesto-title {
    font-size: var(--fs-mega);
    text-transform: uppercase;
    line-height: 0.88;
    letter-spacing: -0.055em;
    max-width: 12ch;
  }
  .manifesto-strike {
    position: relative;
    white-space: nowrap;
  }
  .manifesto-strike::after {
    content: '';
    position: absolute;
    left: -0.03em;
    right: -0.03em;
    top: 52%;
    height: 0.09em;
    background: var(--color-black);
    transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .manifesto-strike::after {
      transform: scaleX(0);
      transition: transform 0.9s var(--ease-in-out) 0.7s;
    }
    :global(.js) .manifesto-title:global(.is-visible) .manifesto-strike::after {
      transform: scaleX(1);
    }
  }
  .manifesto-body {
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .manifesto-lead {
    grid-column: 1 / -1;
    font-size: var(--fs-lead);
    line-height: 1.45;
    font-weight: 500;
    max-width: 34ch;
  }
  .pillars {
    margin-top: clamp(3rem, 7vw, 6rem);
    display: grid;
    border-top: 1px solid var(--color-black);
  }
  .pillar {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1.25rem;
    row-gap: 0.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--line);
  }
  .pillar-glyph {
    grid-row: span 3;
    width: 3rem;
    height: 3rem;
  }
  .pillar-glyph svg {
    width: 100%;
    height: 100%;
  }
  .pillar-num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-micro);
    letter-spacing: 0.16em;
  }
  .pillar-text {
    color: var(--muted);
    max-width: 32ch;
  }
  @media (min-width: 900px) {
    .manifesto-lead {
      grid-column: 7 / -1;
    }
    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .pillar {
      grid-template-columns: 1fr;
      padding: 2rem 2rem 0.5rem 0;
      border-bottom: 0;
    }
    .pillar + .pillar {
      padding-left: 2rem;
      border-left: 1px solid var(--line);
    }
    .pillar-glyph {
      grid-row: auto;
      margin-bottom: 2.5rem;
    }
  }
</style>
